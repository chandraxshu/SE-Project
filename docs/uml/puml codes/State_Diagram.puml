@startuml
title State Machine Diagram: Item Lifecycle & Claim Lifecycle

hide empty description
skinparam shadowing false
skinparam defaultFontName Arial
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  ArrowColor #1D4ED8
  StartColor #16A34A
  EndColor #DC2626
}

[*] --> Active

state "Item Lifecycle" as ItemLifecycle {
  [*] --> Active : Reporter submits found/lost report
  
  Active : Item is publicly visible on noticeboard
  Active : Available for student claims (if found)
  
  Active --> Claimed : Administrator approves a claim
  Claimed : Item reserved for approved claimant
  Claimed : Further claims blocked
  
  Claimed --> Returned : Admin confirms physical handover at desk
  Returned : Item physically received by owner
  Returned : Archived in permanent return ledger
  
  Active --> Archived : Admin archives expired or duplicate listing
  Claimed --> Active : Approved claim revoked by admin
  
  Returned --> [*]
  Archived --> [*]
}

state "Claim Lifecycle" as ClaimLifecycle {
  [*] --> PendingReview : Student submits ownership claim
  
  PendingReview : Awaiting administrative review
  PendingReview : Proof details kept confidential
  
  PendingReview --> Approved : Admin approves proof
  Approved : Claim confirmed
  
  Approved --> AwaitingHandover : Automatically staged for physical collection
  AwaitingHandover : Claimant instructed to visit security desk with ID
  
  PendingReview --> Rejected : Admin rejects due to insufficient proof
  PendingReview --> Rejected : Automatically rejected when another claim is approved
  Rejected : Review note provided to student
  
  AwaitingHandover --> ClaimResolved : Physical handover confirmed at desk
  ClaimResolved : Recipient roll number recorded in audit log
  
  Rejected --> [*]
  ClaimResolved --> [*]
}

@enduml